#!/bin/bash
# The unprivileged half of one Bot desktop: a private X server, window manager,
# RFB socket and the kiosk shell. Every path comes from session-start's env.
set -euo pipefail
: "${DISPLAY:?}" "${XAUTHORITY:?}" "${XDG_RUNTIME_DIR:?}" "${VNC_SOCKET:?}"
export SHELL=/bin/bash
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
# Bare Xvfb has no settings daemon to set org.a11y.Status.IsEnabled.
# Chromium needs both this session opt-in and its renderer accessibility flag.
export ACCESSIBILITY_ENABLED=1 QT_ACCESSIBILITY=1
unset NO_AT_BRIDGE
dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --nofork &
bus_pid=$!
for _ in $(seq 1 100); do
  if [ -S "$XDG_RUNTIME_DIR/bus" ]; then break; fi
  sleep 0.05
done
python3 -c 'import tkinter; from PIL import ImageTk'
Xvfb "$DISPLAY" -screen 0 1280x800x24 -nolisten tcp -auth "$XAUTHORITY" &
display_pid=$!
for _ in $(seq 1 100); do
  if xdotool getdisplaygeometry >/dev/null 2>&1; then break; fi
  sleep 0.1
done
xdotool getdisplaygeometry
openbox &
x11vnc -display "$DISPLAY" -auth "$XAUTHORITY" -unixsock "$VNC_SOCKET" -rfbport 0 \
  -rfbportv6 0 -no6 -nopw -forever -shared &
vnc_pid=$!
KAI_DESKTOP_RUNTIME="$XDG_RUNTIME_DIR" \
  python3 /usr/local/lib/kai-desktop/desktop-shell.py &
shell_pid=$!
# Closing the browser does not tear down the desktop's display service.
wait -n "$bus_pid" "$display_pid" "$vnc_pid" "$shell_pid"
