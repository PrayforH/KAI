#!/bin/bash
# Start one Bot desktop. Runs as guest root only to create the private runtime
# directory, then drops to the slot's own unprivileged account.
set -euo pipefail
umask 077
desktop_id="${1:-}"
if [[ ! "$desktop_id" =~ ^desktop_[0-9a-f]{24}$ ]]; then
  echo 'desktop-session: invalid instance' >&2
  exit 64
fi
env_file="/etc/kai-desktop/sessions/$desktop_id.env"
test -f "$env_file"
set -a
# shellcheck disable=SC1090
. "$env_file"
set +a
test "$DESKTOP_ID" = "$desktop_id"
if [[ ! "$UNIX_USER" =~ ^kai-bot-[0-9a-f]{8}$ || ! "$DISPLAY_NUMBER" =~ ^1[0-9]{2}$ ]]; then
  echo 'desktop-session: invalid account or display' >&2
  exit 64
fi
test "$VNC_SOCKET" = "/run/kai-bots/$desktop_id/vnc.sock"
test "$HOME" = "/home/kai-bots/$(basename "$(dirname "$PROFILE")")"
test "$PROFILE" = "$HOME/chromium"
test "$WORKSPACE" = "$HOME/workspace"
uid="$(id -u "$UNIX_USER")"
gid="$(id -g "$UNIX_USER")"
install -d -m 0711 -o root -g root /run/kai-bots
runtime="/run/kai-bots/$desktop_id"
install -d -m 0700 -o "$UNIX_USER" -g "$UNIX_USER" "$runtime"
exec setpriv --reuid="$uid" --regid="$gid" --init-groups \
  env -i PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 TZ="${TZ:-Asia/Shanghai}" \
  HOME="$HOME" DISPLAY=":$DISPLAY_NUMBER" XAUTHORITY="$runtime/Xauthority" \
  XDG_RUNTIME_DIR="$runtime" KAI_DESKTOP_RUNTIME="$runtime" \
  DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
  DESKTOP_ID="$desktop_id" VNC_SOCKET="$VNC_SOCKET" \
  /usr/local/lib/kai-desktop/session-body
