COMPOSE_PROJECT_NAME=claude-agent-harness

# Image source. Leave the repository values unchanged for local builds, or point
# them at Harbor and use an immutable tag for repeatable deployment/rollback.
HARNESS_API_IMAGE_REPOSITORY=claude-agent-harness-api
HARNESS_WEB_IMAGE_REPOSITORY=claude-agent-harness-web
HARNESS_IMAGE_TAG=local

# Domestic dependency mirrors; replace when deploying outside mainland China.
UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
CODEX_VERSION=0.149.0
CODEX_LINUX_X64_SHA256=e06f3d106fe8bb058a6bfd30075d89ea17deaee7c8425e0c5d23072df0fdd0e7
CODEX_NPM_REGISTRY=https://registry.npmmirror.com
HARNESS_RUNTIME=multi
HARNESS_CODEX_CLI_PATH=/usr/local/bin/codex
HARNESS_CODEX_MODEL_BY_ROUTE={}
HARNESS_CODEX_PROVIDER_BY_ROUTE={}
HARNESS_CODEX_APPROVAL_POLICY=untrusted
HARNESS_CODEX_NETWORK_ACCESS=false
KUBECTL_IMAGE=cgr.dev/chainguard/kubectl@sha256:1e1aa9dedf0d9008e5a3710b23f2072bc2ab83117146d503c689b5d2592add3d

POSTGRES_PASSWORD=replace-with-a-long-password
MINIO_ROOT_USER=harness-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-password

# Model endpoints and credentials are configured after startup in Settings → Model Management.
HARNESS_API_BEARER_TOKEN=replace-with-at-least-32-random-characters
HARNESS_AUTH_JWT_SECRET=replace-with-a-different-32-character-random-secret
HARNESS_MEMORY_WORKLOAD_TOKEN_SECRET=replace-with-a-third-32-character-random-secret
HARNESS_KNOWLEDGE_WORKLOAD_TOKEN_SECRET=replace-with-a-fourth-32-character-random-secret
HARNESS_AUTH_ALLOW_REGISTRATION=true
HARNESS_AUTH_ACCESS_TOKEN_MINUTES=30
HARNESS_AUTH_REFRESH_TOKEN_DAYS=30
HARNESS_AUTH_DEFAULT_TENANT_ID=local
# Public URL reachable from Daytona/Kubernetes sandboxes. Leave blank for read-only remote memory.
HARNESS_MEMORY_MCP_PUBLIC_URL=
# Public URL reachable from Daytona/Kubernetes sandboxes.
HARNESS_KNOWLEDGE_MCP_PUBLIC_URL=

# Browser-facing origin. Keep false only for local HTTP; production HTTPS must use true.
AUTH_PUBLIC_URL=http://localhost:3000
AUTH_COOKIE_SECURE=false

# Optional OAuth/OIDC providers. Leave blank to use email registration/login only.
# Google callback: ${AUTH_PUBLIC_URL}/api/auth/oauth/google/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# GitHub callback: ${AUTH_PUBLIC_URL}/api/auth/oauth/github/callback
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
HARNESS_SANDBOX_PROVIDER=daytona
# worker_cli_deferred keeps the Claude CLI in the Worker and allocates the
# remote sandbox only when Read/Write/Edit/Bash/Glob/Grep first runs.
HARNESS_SANDBOX_EXECUTION_MODE=worker_cli_deferred
HARNESS_ALLOW_UNSAFE_LOCAL_SANDBOX=false
HARNESS_DAYTONA_API_KEY=
HARNESS_DAYTONA_API_URL=https://app.daytona.io/api
HARNESS_DAYTONA_REMOTE_WORKSPACE_ROOT=/home/daytona/harness
HARNESS_DAYTONA_CLAUDE_CLI_VERSION=2.1.206
HARNESS_DAYTONA_CLAUDE_CLI_PATH=/home/daytona/.local/bin/claude
HARNESS_DAYTONA_DELETE_ON_DESTROY=true
HARNESS_DAYTONA_AUTO_STOP_INTERVAL_MINUTES=15
HARNESS_DAYTONA_AUTO_DELETE_INTERVAL_MINUTES=60
HARNESS_DAYTONA_RECOVERY_RETENTION_SECONDS=3600
# Alternative private execution backend. Image must be pinned by digest.
HARNESS_KUBERNETES_NAMESPACE=harness-sandboxes
HARNESS_KUBERNETES_IMAGE=
HARNESS_KUBERNETES_RUNTIME_CLASS_NAME=gvisor
HARNESS_KUBERNETES_SERVICE_ACCOUNT_NAME=harness-sandbox
HARNESS_KUBERNETES_KUBECTL_PATH=kubectl
HARNESS_KUBERNETES_KUBECONFIG=
HARNESS_KUBERNETES_CONTEXT=
HARNESS_KUBERNETES_EGRESS_PROXY_URL=http://harness-egress-proxy.harness-system.svc:3128
HARNESS_KUBERNETES_EGRESS_GATEWAY_NAMESPACE=harness-system
HARNESS_KUBERNETES_EGRESS_GATEWAY_PORT=3128
HARNESS_KUBERNETES_EGRESS_GATEWAY_SELECTOR_JSON={"app.kubernetes.io/name":"harness-egress-proxy"}
HARNESS_KUBERNETES_POD_TTL_SECONDS=3600
HARNESS_KUBERNETES_REAPER_INTERVAL_SECONDS=30
HARNESS_WORKER_TASK_VISIBILITY_TIMEOUT_SECONDS=60
HARNESS_WORKER_TASK_RETRY_DELAY_SECONDS=1
HARNESS_WORKER_TASK_HEARTBEAT_SECONDS=20
HARNESS_WORKER_REPLICAS=1
HARNESS_WORKER_CONCURRENCY=4
# Limit Worker-local model processes; Python/non-read-only MCP Runs bypass this
# lane and execute through the remote Sandbox CLI.
HARNESS_WORKER_DEFERRED_MAX_ACTIVE_RUNS=2
HARNESS_CODEX_TOOL_OUTPUT_TOKEN_LIMIT=32000
HARNESS_RUN_RESERVATION_TTL_SECONDS=86400
HARNESS_QUOTA_ENFORCEMENT_ENABLED=false
HARNESS_PREFLIGHT_TIMEOUT_SECONDS=180
HARNESS_WORKSPACE_ARCHIVE_MAX_BYTES=536870912
HARNESS_WORKSPACE_ARCHIVE_MAX_MEMBERS=10000
HARNESS_DAYTONA_TARGET=
HARNESS_DAYTONA_SNAPSHOT=

HARNESS_MCP_SECRET_REFERENCES_JSON={"tavily-readonly":{"api_key":"TAVILY_API_KEY"}}
HARNESS_MCP_SERVER_SECRETS_JSON={"TAVILY_API_KEY":"replace-with-tavily-api-key"}
# Optional explicit HTTP(S) proxy used only for manual MCP address detection.
# Docker Desktop/Colima can reach a host proxy through host.docker.internal.
HARNESS_MCP_DISCOVERY_PROXY_URL=

# Enable together with: docker compose --profile observability up -d
HARNESS_OTEL_ENABLED=false
# off for production by default; redacted is an explicit debugging opt-in.
HARNESS_OTEL_CONTENT_CAPTURE=off
HARNESS_OTEL_CONTENT_MAX_CHARS=12000
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=replace-with-project-id
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# Optional collector-only proxy for Langfuse reachable through a host VPN.
# For Docker Desktop/Colima, use http://host.docker.internal:<proxy-port>.
LANGFUSE_EXPORT_PROXY_URL=
LANGFUSE_EXPORT_NO_PROXY=localhost,127.0.0.1,otel-collector
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_ENVIRONMENT=production

HARNESS_TENANT_ID=local
HARNESS_USER_ID=developer
HARNESS_AGENT_NAME=lead-agent
HARNESS_AGENT_VERSION=1.0.0
HARNESS_WORKER_METRICS_PORT=8001
HARNESS_RELIABILITY_REAPER_INTERVAL_SECONDS=30
HARNESS_STUCK_QUEUED_SECONDS=120
HARNESS_STUCK_PROVISIONING_SECONDS=300
HARNESS_STUCK_RUNNING_SECONDS=3600
HARNESS_STUCK_WAITING_APPROVAL_SECONDS=900
HARNESS_STUCK_CANCELLING_SECONDS=30
