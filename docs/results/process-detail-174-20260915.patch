 }
+
+/* Keep the disclosure truly collapsed even when the theme sets display:block. */
+body.codex-theme-v1 .execution-tree[hidden] { display: none; }
+body.codex-theme-v1 .execution-display-controls {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin-bottom: 10px;
+  color: var(--codex-faint);
+  font-size: 11px;
+}
+body.codex-theme-v1 .execution-display-switch {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  min-height: 28px;
+  padding: 3px 0 3px 8px;
+  border: 0;
+  background: transparent;
+  color: var(--codex-muted);
+  font: inherit;
+  cursor: pointer;
+}
+body.codex-theme-v1 .execution-display-switch:focus-visible {
+  outline: 2px solid var(--codex-accent);
+  outline-offset: 3px;
+  border-radius: 4px;
+}
+body.codex-theme-v1 .execution-switch-track {
+  width: 25px;
+  height: 15px;
+  padding: 2px;
+  box-sizing: border-box;
+  border-radius: 10px;
+  background: var(--codex-line);
+}
+body.codex-theme-v1 .execution-switch-track::after {
+  content: "";
+  display: block;
+  width: 11px;
+  height: 11px;
+  border-radius: 50%;
+  background: var(--codex-muted);
+  transition: transform 150ms ease;
+}
+body.codex-theme-v1 .execution-display-switch[aria-checked="true"] .execution-switch-track { background: var(--codex-ink-soft); }
+body.codex-theme-v1 .execution-display-switch[aria-checked="true"] .execution-switch-track::after {
+  transform: translateX(10px);
+  background: var(--codex-bg, #101010);
+}
+body.codex-theme-v1 .execution-process-note,
+body.codex-theme-v1 .execution-current-line {
+  margin: 8px 0 2px;
+  color: var(--codex-muted);
+  font-size: 12px;
+  line-height: 1.6;
+}
+body.codex-theme-v1 .execution-process-note + .execution-log { margin-top: 12px; }
+body.codex-theme-v1 .execution-current-line span { display: inline-block; }
+/* The moving dark band is clipped to glyphs, so it never covers content. */
+body.codex-theme-v1 .execution-ribbon .execution-text-sweep {
+  color: transparent;
+  background-image: linear-gradient(100deg, var(--codex-muted) 35%, #101010 48%, var(--codex-muted) 61%);
+  background-size: 260% 100%;
+  background-clip: text;
+  -webkit-background-clip: text;
+  animation: execution-text-sweep 1.8s linear infinite;
+}
+@keyframes execution-text-sweep {
+  from { background-position: 100% 0; }
+  to { background-position: 0% 0; }
+}
+@media (prefers-reduced-motion: reduce) {
+  body.codex-theme-v1 .execution-ribbon .execution-text-sweep { animation: none; background: none; color: var(--codex-muted); }
+  body.codex-theme-v1 .execution-switch-track::after { transition: none; }
+}
