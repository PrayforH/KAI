--- a/web/harness-console/src/app/conversation-experience.css
+++ b/web/harness-console/src/app/conversation-experience.css
@@ -420,3 +420,73 @@
   body.codex-theme-v1 .execution-row-sweep::after { animation: none; display: none; }
   body.codex-theme-v1 .execution-reasoning-summary::before { transition: none; }
 }
+
+/* Attachment cards share one box for preview, metadata and upload state. */
+body.codex-theme-v1 .harness-composer-shell .aui-composer-attachments {
+  box-sizing: border-box;
+  display: flex;
+  flex: none;
+  align-items: flex-start;
+  gap: 8px;
+  width: 100%;
+  min-width: 0;
+  padding: 12px 12px 4px;
+}
+body.codex-theme-v1 .harness-composer-shell .aui-composer-attachments:empty { display: none; }
+body.codex-theme-v1 .harness-composer-shell .composer-file-card {
+  position: relative;
+  flex: 0 0 232px;
+  width: 232px;
+  max-width: 100%;
+  min-width: 0;
+}
+body.codex-theme-v1 .harness-composer-shell .aui-composer-attachments .aui-attachment-root {
+  height: auto;
+  min-width: 0;
+  margin: 0;
+}
+body.codex-theme-v1 .harness-composer-shell .aui-attachment-content {
+  box-sizing: border-box;
+  width: 100%;
+  height: 76px;
+  min-width: 0;
+  justify-content: flex-start;
+  align-items: flex-start;
+  gap: 10px;
+  padding: 10px 32px 24px 10px;
+  border-radius: 10px;
+}
+body.codex-theme-v1 .harness-composer-shell .aui-attachment-thumb {
+  flex: 0 0 36px;
+  width: 36px;
+  height: 36px;
+  overflow: hidden;
+}
+body.codex-theme-v1 .harness-composer-shell .aui-attachment-thumb img { width: 100%; height: 100%; object-fit: cover; }
+body.codex-theme-v1 .harness-composer-shell .aui-attachment-text { flex: 1 1 0; min-width: 0; }
+body.codex-theme-v1 .harness-composer-shell .aui-attachment-name {
+  display: block;
+  margin: 0;
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  font-size: 12px;
+  line-height: 18px;
+}
+body.codex-theme-v1 .harness-composer-shell .aui-attachment-type { margin: 0; font-size: 11px; line-height: 18px; }
+body.codex-theme-v1 .harness-composer-shell .aui-composer-attachments .aui-attachment-remove {
+  top: 6px;
+  right: 6px;
+  width: 24px;
+  height: 24px;
+  padding: 4px;
+}
+body.codex-theme-v1 .harness-composer-shell .composer-file-card .attachment-upload-status {
+  inset: auto 32px 9px 56px;
+  color: var(--codex-muted);
+  font-size: 10px;
+  line-height: 14px;
+}
+body.codex-theme-v1 .harness-composer-shell .composer-file-card .attachment-upload-status.error { color: var(--codex-danger, #c45443); }
+body.codex-theme-v1 .harness-composer-shell .composer-file-card .attachment-upload-status > span { max-width: 100%; }
+body.codex-theme-v1 .harness-composer-shell .composer-file-card .attachment-upload-track { margin-top: 2px; }
